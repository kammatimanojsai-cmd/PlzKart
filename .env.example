# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / any Postgres).
# Leave unset locally to use the built-in embedded database (PGlite, stored in .pglite/).
DATABASE_URL=

# Public base URL used in email links. Optional: derived from the request host if unset.
APP_URL=

# ---- Email (pick ONE provider) ----
# Option A: Resend (https://resend.com) HTTP API
RESEND_API_KEY=
# Sender, e.g. "PlzKart <onboarding@resend.dev>" (resend.dev only delivers to your own Resend account email)
EMAIL_FROM=

# Option B: any SMTP server, e.g. Gmail with an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
